#!/usr/bin/expect -f

# Record a genuine installer and two-turn, cross-model Muse TUI session.
# The OpenRouter key is read from a file and entered only at getpass's
# no-echo prompt. Asciinema's stdin recording must remain disabled.

if {$argc != 2} {
    puts stderr "usage: capture-live-demo.exp KEY_FILE DEMO_HOME"
    exit 2
}

set key_file [lindex $argv 0]
set demo_home [lindex $argv 1]
set key_handle [open $key_file r]
set api_key [string trim [read $key_handle]]
close $key_handle

if {![string match "sk-or-v1-*" $api_key]} {
    puts stderr "temporary OpenRouter key has an unexpected format"
    exit 2
}

set timeout 300
set prompt_tail {$ }
# Keep the exact public install command while forcing its systemd probe to
# fall back to the isolated background process managed by this recording.
set demo_bin "$demo_home/demo-bin"
file mkdir $demo_bin
set systemctl_handle [open "$demo_bin/systemctl" w]
puts $systemctl_handle "#!/bin/sh"
puts $systemctl_handle "exit 1"
close $systemctl_handle
file attributes "$demo_bin/systemctl" -permissions 0755

set env(HOME) $demo_home
set env(XDG_CONFIG_HOME) "$demo_home/.config"
set env(XDG_STATE_HOME) "$demo_home/.local/state"
set env(XDG_DATA_HOME) "$demo_home/.local/share"
set env(UV_TOOL_DIR) "$demo_home/.local/share/uv/tools"
set env(UV_TOOL_BIN_DIR) "$demo_home/.local/bin"
set env(PATH) "$demo_home/.local/bin:$demo_bin:$env(PATH)"
set env(MUSE_NO_AUTO_UPDATE) "1"
# OpenRouter does not expose Muse's Meta-hosted web-search endpoint. Keep the
# live demo on the model itself so a factual question does not invoke that
# provider-specific tool.
set env(MUSE_WEB_SEARCH_MODE) "off"
set env(MUSE_ENABLE_WEB_TOOLS) "0"
set env(PS1) {\[\e[1;32m\]demo@terminal\[\e[0m\]:\[\e[1;34m\]~\[\e[0m\]$ }
set env(TERM) "xterm-256color"
set env(COLORTERM) "truecolor"
set env(CLICOLOR_FORCE) "1"
set env(FORCE_COLOR) "1"

# The recording starts in this isolated directory. Pre-trust only that empty
# directory so `muse` opens directly into the TUI without a first-run prompt.
set trust_dir "$demo_home/.config/muse"
file mkdir $trust_dir
set escaped_home [string map [list "\\" "\\\\" "\"" "\\\""] $demo_home]
set trust_handle [open "$trust_dir/trust.json" w]
puts $trust_handle "{\"schema_version\":1,\"projects\":{\"$escaped_home\":{\"decision\":\"trusted\"}}}"
close $trust_handle

# Muse's full-screen TUI queries terminal capabilities. tmux supplies the
# terminal-emulation layer that a bare recorder PTY does not have; its own UI
# is disabled so the recording still begins at the normal shell prompt.
set tmux_config "$demo_home/tmux.conf"
set tmux_handle [open $tmux_config w]
puts $tmux_handle "set -g status off"
close $tmux_handle
set tmux_socket "muse-openrouter-demo-[pid]"

proc type_command {text} {
    foreach character [split $text ""] {
        send -- $character
        # Expect must read the echoed character now; otherwise its nested PTY
        # buffers the whole command and asciinema makes it look pasted.
        expect -exact $character
        # A natural terminal cadence: visible keystrokes, with slight variance.
        after [expr {44 + int(rand() * 37)}]
    }
    after 500
    send -- "\r"
}

proc type_tui {text} {
    foreach character [split $text ""] {
        send -- $character
        # Muse redraws its composer for each keystroke. The delay keeps those
        # real redraws visible instead of making the message look pasted.
        set delay [expr {44 + int(rand() * 37)}]
        after 25
        expect -timeout 0 {
            -re {.+} {}
            timeout {}
        }
        after [expr {$delay - 25}]
    }
    after 500
    send -- "\r"
}

proc visible_pause {milliseconds} {
    # Keep draining Muse's PTY during pauses so asciinema records spinners,
    # redraws, and model work at their real timestamps instead of in a batch.
    set elapsed 0
    while {$elapsed < $milliseconds} {
        after 100
        expect -timeout 0 {
            -re {.+} {}
            timeout {}
        }
        incr elapsed 100
    }
}

proc wait_for_tui_idle {socket timeout_ms} {
    set elapsed 0
    set stable_checks 0
    while {$elapsed < $timeout_ms} {
        visible_pause 500
        incr elapsed 500
        if {[catch {exec tmux -L $socket capture-pane -p -t 0} pane]} {
            continue
        }
        if {[string first "esc to interrupt" $pane] < 0 && [regexp -line {^◆ .+} $pane]} {
            incr stable_checks
            if {$stable_checks >= 6} {
                return
            }
        } else {
            set stable_checks 0
        }
    }
    puts stderr "Glimmer did not finish the live TUI response"
    exit 1
}

cd $demo_home
spawn -noecho tmux -f $tmux_config -L $tmux_socket new-session -x 90 -y 28 \
    /bin/bash --noprofile --norc -i
expect -exact $prompt_tail

type_command "curl -LsSf https://xhluca.github.io/muse-code-openrouter/install.sh | sh"
expect -exact "OpenRouter API key: "
send -- "$api_key\r"
expect {
    -re {Model \[1-[0-9]+\] \(default ([0-9]+)\): } {
        set selected_index $expect_out(1,string)
    }
    timeout { puts stderr "timed out waiting for the model chooser"; exit 1 }
}
visible_pause 1200
send -- $selected_index
expect -exact $selected_index
after 500
send -- "\r"
expect {
    -exact "Muse Code is ready. Run: muse" {}
    timeout { puts stderr "timed out waiting for installation"; exit 1 }
}
expect -exact $prompt_tail

# Keep this factual demo concise while still launching Muse with the plain
# `muse` command. The installer preserves existing Muse reasoning settings, so
# this represents a normal user configured for minimal effort.
set settings_path "$demo_home/.config/muse/settings.json"
set settings_handle [open $settings_path r]
set settings_json [read $settings_handle]
close $settings_handle
set settings_json [string replace $settings_json 0 0 "{\n  \"reasoning_effort\": \"minimal\","]
set settings_handle [open $settings_path w]
puts -nonewline $settings_handle $settings_json
close $settings_handle

type_command "muse"
expect {
    -exact "Model set to meta/muse-spark-1.2" {}
    timeout { puts stderr "Muse TUI did not start with Spark"; exit 1 }
}
after 1200

type_tui "/model"
expect {
    -re {↑↓[^\r\n]*confirm} {}
    timeout { puts stderr "Muse model picker did not open"; exit 1 }
}
visible_pause 1000
send -- "\033\[A"
visible_pause 900
send -- "\033\[A"
visible_pause 1200
send -- "\r"
expect {
    -exact "Model set to meta/muse-glimmer-30b" {}
    timeout { puts stderr "Muse did not switch to Glimmer"; exit 1 }
}
visible_pause 1200

type_tui "Explain what is meta's muse glimmer"
expect {
    -re {◆} {}
    timeout { puts stderr "Glimmer did not start the live TUI response"; exit 1 }
}

wait_for_tui_idle $tmux_socket 300000
visible_pause 3000
send -- "\003"
visible_pause 300
send -- "\003"
expect -exact $prompt_tail
send -- "exit\r"
expect eof
